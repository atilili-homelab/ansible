use flake

# BAO_ADDR pour le client bao, VAULT_ADDR pour la fonction vault() de Ansible
export BAO_ADDR='http://sati.macopla.home:8200'
export VAULT_ADDR="$BAO_ADDR"

ANSIBLE_HASHI_VAULT_ROLE_ID="$(rbw get 'Openbao Ansible Role_id')"
ANSIBLE_HASHI_VAULT_SECRET_ID="$(rbw get 'Openbao Ansible Secret_id')"
export ANSIBLE_HASHI_VAULT_ROLE_ID
export ANSIBLE_HASHI_VAULT_SECRET_ID

# Connexion AppRole : en cas d'échec, on prévient sans bloquer,
# pour que les outils et BAO_ADDR restent disponibles
ansible_vault_login() {
    if ! rbw unlocked >/dev/null 2>&1; then
        log_error "rbw verrouillé — lance 'rbw unlock' puis 'direnv reload'"
        return 1
    fi
    local role_id
    # En cas d'échec, role_id contient le message d'erreur de rbw (2>&1)
    if ! role_id="$(rbw get 'Openbao Ansible Role_id' 2>&1)"; then
        log_error "lecture rbw 'Openbao Ansible Role_id' impossible : $role_id"
        return 1
    fi
    # secret_id passé par stdin, jamais en argument (visible dans la liste des processus)
    VAULT_TOKEN="$(rbw get 'Openbao Ansible Secret_id' |
        bao write -field=token auth/approle/login role_id="$role_id" secret_id=-)" || {
        log_error "connexion AppRole OpenBao échouée"
        return 1
    }
    export VAULT_TOKEN
}
if ! rbw unlocked >/dev/null 2>&1; then
    log_error "rbw verrouillé — lance 'rbw unlock' puis 'direnv reload'"
    exit 1
fi

ansible_vault_login || log_error "VAULT_TOKEN non défini : Ansible ne pourra pas lire ses secrets"
