use flake

# BAO_ADDR pour le client bao, VAULT_ADDR pour la fonction vault() de Ansible
export BAO_ADDR='http://sati.macopla.home:8200'
export VAULT_ADDR="$BAO_ADDR"

# Connexion OpenBao : en cas d'échec, on prévient sans bloquer,
# pour que les outils et BAO_ADDR restent disponibles
ansible_vault_login() {
    # Session yoann partagée avec les autres dépôts (~/.vault-token), ouverte si absente ou expirée
    if ! bao token lookup >/dev/null 2>&1; then
        if ! rbw unlocked >/dev/null 2>&1; then
            log_error "rbw verrouillé — lance 'rbw unlock' puis 'direnv reload'"
            return 1
        fi
        # Mot de passe passé par stdin, jamais en argument (visible dans la liste des processus)
        rbw get openbao-yoann |
            bao write -field=token auth/userpass/login/yoann password=- |
            bao login -no-print - || {
            log_error "connexion userpass OpenBao échouée"
            return 1
        }
    fi
    # La session est admin : Ansible ne reçoit qu'un token enfant limité à ansible-policy,
    # révoqué en même temps que la session
    VAULT_TOKEN="$(bao token create -policy=ansible-policy -ttl=1h -field=token)" || {
        log_error "création du token ansible échouée"
        return 1
    }
    export VAULT_TOKEN
}

ansible_vault_login || log_error "VAULT_TOKEN non défini : Ansible ne pourra pas lire ses secrets"
