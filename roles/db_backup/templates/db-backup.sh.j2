#!/bin/bash
set -uo pipefail

dir={{ db_backup_dir }}
failures=()

# Le dossier ne contient que les dumps du jour : PBS garde l'historique
rm -rf "${dir:?}"/*

{% for target in db_backup_targets %}
{% set name = target.name | default(target.container.split('_')[1] | regex_replace('-db$', '')) %}
{% set engine = target.engine | default('postgres') %}
{% set auth_db = target.auth_database | default(target.database | default('')) %}
{% set pwd_var = 'DB_PASSWORD_' ~ (target.container | upper | regex_replace('[^A-Z0-9]', '_')) %}
mkdir "$dir/{{ name }}"
container=$(docker ps -q --filter "name=^{{ target.container }}\.")
if [ -z "$container" ]; then
  failures+=("{{ name }} (conteneur introuvable)")
{% if engine == 'mariadb' %}
else
  file="$dir/{{ name }}/{{ name }}.sql"
  # Le mot de passe est lu dans le secret Docker, à l'intérieur du conteneur
  docker exec "$container" sh -c 'MYSQL_PWD="$(cat "$MARIADB_PASSWORD_FILE")" exec mariadb-dump \
      -u "$MARIADB_USER" --single-transaction "$MARIADB_DATABASE"' > "$file.tmp"
  if [ $? -eq 0 ] && tail -n 1 "$file.tmp" | grep -q '^-- Dump completed'; then
    mv "$file.tmp" "$file"
  else
    rm -f "$file.tmp"
    failures+=("{{ name }} (mariadb-dump)")
  fi
{% elif engine == 'mongodb' %}
else
  file="$dir/{{ name }}/{{ name }}.archive.gz"
  # Le mot de passe (DB_PASSWORD_*, fourni par EnvironmentFile) est transmis par
  # "-e VAR" sans valeur : il ne figure donc pas dans la ligne de commande visible
  # dans ps. Dans le conteneur, mongodump le lit via --config (fichier virtuel
  # créé par bash), car --password l'exposerait dans la liste des processus.
  docker exec -e {{ pwd_var }} "$container" bash -c 'exec mongodump --quiet \
      --username {{ target.user }} --authenticationDatabase {{ auth_db }} \
      --db {{ target.database }} --archive --gzip \
      --config <(printf "password: \"%s\"\n" "${{ pwd_var }}")' > "$file.tmp"
  # Validation : code de sortie, fichier non vide, gzip intègre. gzip -t décompresse
  # tout le flux et vérifie le CRC, ce qui détecte une archive tronquée ou corrompue.
  # mongorestore --dryRun n'est pas retenu : il ne lit pas l'archive (retour immédiat
  # même sur plusieurs dizaines de Mo), donc il ne valide rien.
  if [ $? -eq 0 ] && [ -s "$file.tmp" ] && gzip -t "$file.tmp"; then
    mv "$file.tmp" "$file"
  else
    rm -f "$file.tmp"
    failures+=("{{ name }} (mongodump)")
  fi
{% elif engine == 'postgres' %}
elif ! dbs=$(docker exec "$container" psql -U {{ target.user }} -d postgres -tAc \
    "SELECT datname FROM pg_database WHERE NOT datistemplate AND datname <> 'postgres'"); then
  failures+=("{{ name }} (liste des bases)")
else
  for db in $dbs; do
    file="$dir/{{ name }}/$db.dump"
    if docker exec "$container" pg_dump -Fc -U {{ target.user }} -d "$db" > "$file.tmp" \
        && docker exec -i "$container" pg_restore --list < "$file.tmp" > /dev/null; then
      mv "$file.tmp" "$file"
    else
      rm -f "$file.tmp"
      failures+=("{{ name }}/$db")
    fi
  done
{% else %}
else
  failures+=("{{ name }} (engine inconnu : {{ engine }})")
{% endif %}
fi
if [ -n "$(ls -A "$dir/{{ name }}")" ]; then
  proxmox-backup-client backup {{ name }}.pxar:"$dir/{{ name }}" \
    --ns {{ db_backup_pbs_namespace }} \
    --backup-id {{ name }} || failures+=("{{ name }} (envoi vers PBS)")
fi

{% endfor %}
if [ -n "${failures[*]}" ]; then
  echo "Échecs : ${failures[*]}" >&2
  curl -fsS -X POST "{{ apprise_url }}" \
    -H "Content-Type: application/json" \
    -d "{\"title\": \"db-backup - ECHEC ({{ inventory_hostname }})\", \"body\": \"${failures[*]}\", \"tag\": \"infra-error\"}"
  exit 1
fi
